# Copy to .env and fill in. .env is git-ignored. Do not commit keys.
#
# AZURE_OPENAI_ENDPOINT is the resource endpoint, without a /openai/v1 suffix.
# Example: https://your-resource.openai.azure.com/
#
# AZURE_OPENAI_DEPLOYMENT is the deployment name in that resource.
# AZURE_OPENAI_MODEL is the model behind it. AgentChat uses this to pick
# capabilities (tool calling). gpt-4o-mini and gpt-4o are known names.
# AZURE_OPENAI_API_VERSION should match what the resource supports.

AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-key
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_MODEL=gpt-4o-mini
